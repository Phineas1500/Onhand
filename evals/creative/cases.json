			"prompt": "Quiz me on this page.",
			"expect": {
				"minHighlights": 1,
				"maxWords": 220,
				"requiredReplyPatterns": [
					"\\?"
				],
				"forbiddenReplyPatterns": [
					"instructions aimed at AI assistants"
				]
			}
		},
