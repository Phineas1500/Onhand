      "description": "Save an article, close it, start a new session, and recover its exact evidence from the saved source.",
      "profiles": ["legacy"],
      "setupTurns": [
        {
          "activeTabId": "calibration-article",
          "tabIds": ["calibration-article"],
          "requireSourceCapture": true,
          "turn": {
            "mode": "answer",
            "prompt": "Save and index this source for later. Call browser_capture_state with persist=true and includeSourceContent=true. Do not summarize it or add page annotations."
          }
        }
      ],
      "finalTabIds": ["blank-workspace"],
      "turn": {
        "mode": "answer",
        "prompt": "According to the calibration source I explicitly saved earlier, why does the calibration remain stable? Use only that saved source, not general knowledge."
      },
      "workspace": {
        "activeTabId": "blank-workspace",
        "tabs": [
          {
            "id": "calibration-article",
            "title": "Calibration field notes",
            "url": "https://fixtures.onhand.test/calibration"
          },
          {
            "id": "blank-workspace",
            "title": "Empty research workspace",
            "url": "https://fixtures.onhand.test/empty"
          }
        ],
        "resources": [
          {
            "id": "calibration-source",
            "tabId": "calibration-article",
            "kind": "html",
            "passages": [
              {
                "id": "calibration-mechanism",
                "location": "section: Results",
                "text": "The calibration remains stable because every reading is compared with the same reference window."
              }
            ]
          },
          {
            "id": "blank-source",
            "tabId": "blank-workspace",
            "kind": "html",
            "passages": [
              {
                "id": "blank-notice",
                "location": "section: Workspace",
                "text": "This workspace intentionally contains no calibration evidence."
              }
            ]
          }
        ]
      },
      "expectations": {
        "completion": "answer",
        "mutations": "annotations-allowed",
        "evidenceSlots": [
          {
            "id": "mechanism",
            "description": "The saved article's stated stability mechanism.",
            "requireCitation": false,
            "acceptableEvidence": [
              {
                "sourceId": "calibration-source",
                "passageIds": ["calibration-mechanism"]
              }
            ]
          }
        ],
        "requiredToolGroups": [
          {
            "id": "saved-source-access",
            "anyOf": ["browser_search_saved_sources", "browser_list_artifacts", "browser_restore_state"]
          }
        ],
        "minAnnotations": 0,
        "maxAnnotations": 2,
        "maxModelCalls": 4,
        "maxToolCalls": 10,
        "maxToolErrors": 0,
        "maxDuplicateSources": 0,
        "maxFocusChanges": 1,
        "maxLatencyMs": 45000,
        "requireNoProvisionalAnswer": true
      }
    },
