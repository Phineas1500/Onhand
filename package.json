{
  "name": "onhand",
  "version": "0.4.5",
  "description": "Onhand: contextual AI assistant for learning and research running in a browser extension",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "pi-package",
    "onhand",
    "browser-automation",
    "learning",
    "research"
  ],
  "scripts": {
    "build:browser-runtime": "node ./scripts/build-browser-runtime.mjs && node ./scripts/build-page-toolkit-content.mjs && node ./scripts/build-pdf-corpus-search.mjs",
    "build:pdf-viewer": "node ./scripts/build-pdf-viewer.mjs",
    "build:extension": "npm run build:browser-runtime && npm run build:pdf-viewer",
    "build:extension:raindrop-local": "ONHAND_RAINDROP_WORKSHOP_URL=http://localhost:5899/v1/ npm run build:extension",
    "raindrop:pilot:setup": "node ./scripts/manage-raindrop-development-pilot.mjs setup",
    "raindrop:pilot:start": "node ./scripts/manage-raindrop-development-pilot.mjs start",
    "raindrop:pilot:status": "node ./scripts/manage-raindrop-development-pilot.mjs status",
    "raindrop:pilot:stop": "node ./scripts/manage-raindrop-development-pilot.mjs stop",
    "acceptance:chrome": "node ./scripts/show-chrome-acceptance.mjs",
    "generate:realtime-voice-fixture": "node ./scripts/generate-realtime-voice-fixture.mjs",
    "serve:realtime": "node ./scripts/serve-realtime-session.mjs",
    "serve:fixture": "node ./scripts/serve-browser-runtime-fixture.mjs",
    "serve:agent-trajectories": "node ./scripts/serve-agent-trajectory-fixtures.mjs",
    "website:sync-store": "node ./scripts/sync-chrome-store-version.mjs",
    "website:check-store": "node ./scripts/sync-chrome-store-version.mjs --check",
    "website:sync-release": "node ./scripts/sync-github-release-version.mjs",
    "website:check-release": "node ./scripts/sync-github-release-version.mjs --check",
    "website:verify-analytics": "node ./scripts/verify-website-analytics.mjs",
    "website:sync-tools": "node ./scripts/sync-browser-tools.mjs",
    "website:check-tools": "node ./scripts/sync-browser-tools.mjs --check",
    "sentry:alerts": "node ./scripts/setup-sentry-alerts.mjs",
    "sentry:issues": "node ./scripts/run-sentry-issue-health.mjs",
    "sentry:runtime-smoke": "node ./scripts/run-sentry-runtime-smoke.mjs",
    "sentry:sourcemaps": "node ./scripts/upload-sentry-sourcemaps.mjs",
    "sentry:smoke": "node ./scripts/run-sentry-source-map-smoke.mjs",
    "ops:free-tier": "node ./scripts/run-free-tier-ops-report.mjs",
    "ops:free-tier:check": "node ./scripts/run-free-tier-ops-report.mjs --days=1 --check --fail-on-critical --test-device-hashes=auto",
    "free-tier:bypass": "node ./scripts/free-tier-bypass.mjs",
    "debug:sessions": "node ./scripts/dump-onhand-sessions.mjs",
    "test:fixtures": "node ./scripts/show-test-fixtures.mjs",
    "test:preflight": "node ./scripts/test-preflight.mjs",
    "test:page-toolkit-regressions": "node ./scripts/run-page-toolkit-regressions.mjs",
    "test:page-toolkit-sweep": "node ./scripts/run-page-toolkit-sweep.mjs",
    "test:pdf-toolkit-sweep": "node ./scripts/run-pdf-toolkit-sweep.mjs",
    "test:sidebar-regressions": "node ./scripts/run-sidebar-regressions.mjs",
    "test:browser-runtime-regressions": "node ./scripts/run-browser-runtime-regressions.mjs",
    "test:agent-runtime-modules": "node ./scripts/run-agent-runtime-module-regressions.mjs",
    "test:raindrop-pilot": "node ./scripts/run-raindrop-development-pilot-regressions.mjs",
    "test:routing-probe": "node ./scripts/probe-routing.mjs --selftest",
    "test:free-tier-worker-regressions": "node ./scripts/run-free-tier-worker-regressions.mjs",
    "test:real-browser-anchoring": "node ./scripts/run-real-browser-anchoring.mjs",
    "test:real-online-pdfs": "node ./scripts/run-real-online-pdf-regressions.mjs",
    "test:real-pdf-zoom": "node ./scripts/run-real-pdf-zoom-regressions.mjs",
    "test:live-acceptance": "node ./scripts/run-onhand-live-acceptance.mjs",
    "smoke:browser-runtime": "node ./scripts/run-browser-runtime-smoke.mjs",
    "eval:page-prompts": "node ./scripts/run-page-prompt-eval.mjs",
    "eval:page-teaching-smoke": "node ./scripts/run-page-prompt-eval.mjs --case bayesian-no-page-changes --case mdn-fetch-teach --case energy-heat-pump-summary --case bayes-source-derivation",
    "eval:free-tier-models": "node ./scripts/run-free-tier-model-eval.mjs",
    "eval:agent-trajectories": "node ./scripts/run-agent-trajectory-eval.mjs",
    "eval:agent-trajectories:live": "node ./scripts/run-agent-trajectory-baseline.mjs",
    "eval:intent-classifier": "node ./scripts/run-lane-classifier-eval.mjs",
    "test:agent-trajectory-eval": "node ./scripts/run-agent-trajectory-eval-regressions.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.80.7",
    "@earendil-works/pi-ai": "^0.80.7",
    "@mozilla/readability": "^0.6.0",
    "@sentry/browser": "^10.57.0",
    "@vercel/speed-insights": "^2.0.0",
    "jsdom": "^26.1.0",
    "pdfjs-dist": "^4.10.38",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@raindrop-ai/pi-agent": "0.1.0",
    "@sentry/cli": "^3.5.0",
    "esbuild": "^0.28.1",
    "ws": "^8.21.0"
  }
}
